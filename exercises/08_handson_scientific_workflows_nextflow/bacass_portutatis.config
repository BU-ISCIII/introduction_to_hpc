/*
 * Configuración exclusiva del docente para nf-core/bacass -r dev en Portutatis.
 * No se usa en la práctica del alumnado (nf-core/demo).
 *
 * Los recursos se solicitan por tarea de Nextflow, no por el sbatch que ejecuta
 * el controlador. Los selectores withLabel sobrescriben las etiquetas estándar
 * usadas por los módulos de nf-core.
 */

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/data/courses/hpc_course/references/singularity-cache'
}

process {
    executor      = 'slurm'
    queue         = 'middle_idx'
    jobName       = { "${task.process} (${task.name})" }
    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = -1

    // Tareas muy ligeras: validación, versiones y ficheros auxiliares.
    withLabel:process_single {
        cpus   = 1
        memory = 6.GB
        time   = 2.h
    }

    // FastQC y Prokka, entre otros módulos de coste bajo.
    withLabel:process_low {
        cpus   = 4
        memory = 12.GB
        time   = 4.h
    }

    // fastp y QUAST, entre otros módulos de coste medio.
    withLabel:process_medium {
        cpus   = 8
        memory = 32.GB
        time   = 8.h
    }

    // Unicycler está etiquetado por nf-core como process_high.
    // Es la tarea a la que más conviene dar recursos en el test de short reads.
    withLabel:process_high {
        cpus   = 16
        memory = 64.GB
        time   = 12.h
    }

    withLabel:process_long {
        time = 20.h
    }
}

params {
    // Límites superiores que el propio pipeline puede consultar al ajustar recursos.
    max_cpus   = 16
    max_memory = 64.GB
    max_time   = 12.h
}
